    "#generating a multiplication table\n",
    "n=int(input(\"enter a number: \"))\n",
    "count=1\n",
    "while count<13:\n",
    "    result= n * count\n",
    "    print(f\"{n} * {count} = {result}\")\n",
    "    count+=1\n",
    "print()  "
