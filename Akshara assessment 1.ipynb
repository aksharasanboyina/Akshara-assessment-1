   "source": [
    "#checking a year whether a leap year or not\n",
    "year=int(input(\"enter a year:\"))\n",
    "if (year%4==0 or year%100!=0 ) and year%400==0:\n",
    "    print(f\"{year} is a Leap Year\")\n",
    "else:\n",
    "    print(f\"{year} is not a Leap Year\")"
   ]
