   "source": [
    "# printing pyramid pattern\n",
    "n=int(input(\"enter a number: \"))\n",
    "for i in range(1,n):\n",
    "    for j in range(i,n-1):\n",
    "        print(\" \",end=\" \")\n",
    "    for k in range(1,2*i):\n",
    "        print(\"*\",end=\" \")\n",
    "    print()"
   ]
